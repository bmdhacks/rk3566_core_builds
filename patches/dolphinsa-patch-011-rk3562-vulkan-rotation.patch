+bool Renderer::ShouldRotateDisplay() const
+{
+  // Rotate only for portrait display swapchains (e.g. the RG52 Mini's 720x1280
+  // panel reached through VK_KHR_display / "-p drm"). Landscape panels
+  // (width >= height, such as the RG43H Pro) are presented unrotated.
+  return m_swap_chain &&
+         m_swap_chain->GetWidth() < m_swap_chain->GetHeight();
+}
+
+void Renderer::SetupDisplayRotation()
+{
+  if (m_rotation_pipeline)
+    return;
+
+  // Fullscreen-triangle vertex shader. rawpos is the [0,1] output coordinate over
+  // the portrait swapchain (origin top-left); uv0 samples the landscape offscreen
+  // texture with a 90-degree rotation that matches the system RGA
+  // HAL_TRANSFORM_ROT_90 used elsewhere on the RG52 Mini.
+  //
+  // If the image appears rotated the wrong way (180 degrees off), flip the
+  // direction by changing the uv0 line to:
+  //   uv0 = float2(1.0f - rawpos.y, rawpos.x);
+  static const char vertex_source[] = R"(
+VARYING_LOCATION(0) out float2 uv0;
+#define id gl_VertexID
+#define opos gl_Position
+void main() {
+  float2 rawpos = float2(float((id << 1) & 2), float(id & 2));
+  opos = float4(rawpos * float2(2.0f, -2.0f) + float2(-1.0f, 1.0f), 0.0f, 1.0f);
+  uv0 = float2(rawpos.y, 1.0f - rawpos.x);
+  opos.y = -opos.y;
+}
+)";
+
+  static const char pixel_source[] = R"(
+SAMPLER_BINDING(0) uniform sampler2DArray samp0;
+VARYING_LOCATION(0) in float2 uv0;
+FRAGMENT_OUTPUT_LOCATION(0) out float4 ocol0;
+void main() {
+  ocol0 = texture(samp0, float3(uv0, 0.0f));
+}
+)";
+
+  m_rotation_vertex_shader =
+      CreateShaderFromSource(ShaderStage::Vertex, vertex_source, "Display rotation vertex shader");
+  m_rotation_pixel_shader =
+      CreateShaderFromSource(ShaderStage::Pixel, pixel_source, "Display rotation pixel shader");
+  if (!m_rotation_vertex_shader || !m_rotation_pixel_shader)
+  {
+    PanicAlertFmt("Failed to compile display rotation shaders");
+    return;
+  }
+
+  AbstractPipelineConfig config = {};
+  config.vertex_shader = m_rotation_vertex_shader.get();
+  config.pixel_shader = m_rotation_pixel_shader.get();
+  config.rasterization_state = RenderState::GetNoCullRasterizationState(PrimitiveType::Triangles);
+  config.depth_state = RenderState::GetNoDepthTestingDepthState();
+  config.blending_state = RenderState::GetNoBlendingBlendState();
+  config.framebuffer_state = RenderState::GetColorFramebufferState(m_swap_chain->GetTextureFormat());
+  config.usage = AbstractPipelineUsage::Utility;
+  m_rotation_pipeline = CreatePipeline(config);
+  if (!m_rotation_pipeline)
+    PanicAlertFmt("Failed to create display rotation pipeline");
+}
+
+void Renderer::DrawRotatedBackbuffer()
+{
+  if (!m_rotation_pipeline)
+    return;
+
+  // Finish the offscreen (landscape) render pass and make it sampleable.
+  StateTracker::GetInstance()->EndRenderPass();
+  m_rotation_texture->FinishedRendering();
+
+  // Draw the offscreen texture rotated 90 degrees onto the portrait swapchain.
+  // The swapchain image was already transitioned to COLOR_ATTACHMENT_OPTIMAL in
+  // BindBackbuffer(); we are still inside Swap()'s utility-drawing scope.
+  SetAndDiscardFramebuffer(m_swap_chain->GetCurrentFramebuffer());
+  SetViewportAndScissor(MathUtil::Rectangle<int>(0, 0,
+                                                 static_cast<int>(m_swap_chain->GetWidth()),
+                                                 static_cast<int>(m_swap_chain->GetHeight())));
+  SetPipeline(m_rotation_pipeline.get());
+  SetTexture(0, m_rotation_texture.get());
+  SetSamplerState(0, RenderState::GetLinearSamplerState());
+  Draw(0, 3);
+}
